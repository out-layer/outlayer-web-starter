# Required. Used to sign session JWTs. 32+ random bytes.
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-random-bytes

# Network: 'mainnet' (default) or 'testnet'.
# Testnet works for register / policy / sign-message / NEAR contract calls,
# but NEAR Intents (swap / gasless withdraw) only work on mainnet.
NEAR_NETWORK=mainnet

# Client-side network for the NEAR wallet connector (near-connect).
# Must be readable in the browser, hence the NEXT_PUBLIC_ prefix.
# Keep it in sync with NEAR_NETWORK above.
NEXT_PUBLIC_NEAR_NETWORK=mainnet

# Optional. Override the OutLayer API base URL (takes precedence over NEAR_NETWORK).
# OUTLAYER_BASE_URL=https://api.outlayer.fastnear.com

# Optional. Default staking pool for /api/stake. Pick any NEAR validator.
# VALIDATOR=zavodil.poolv1.near

# Optional. Domain shown in the sign-in message — change to match your deployment.
APP_DOMAIN=localhost:3000
